{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syli Pharmacie",
  "version": "0.1.0",
  "identifier": "health.syli.pharmacie",
  "build": {
    "beforeDevCommand": "pnpm --filter @syli/web dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter @syli/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Syli Pharmacie",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.syli.health"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Medical",
    "shortDescription": "Ventes, stock et réservations de la pharmacie",
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
